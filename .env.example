# Copia este archivo a .env y completá los valores reales.
# El .env está gitignored: nunca se commitean credenciales.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_aqui
POSTGRES_DB=caa_db

# JWT
JWT_SECRET=tu_secret_jwt_largo_y_aleatorio
JWT_EXPIRATION_MS=3600000

# Cloudinary (credenciales del dashboard de Cloudinary)
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# Google OAuth 2.0 (login con Google) — Client ID de una OAuth Client web
GOOGLE_CLIENT_ID=